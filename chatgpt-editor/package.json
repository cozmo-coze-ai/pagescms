{
  "name": "coze-homepage-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run build:widget && tsc --noEmit && tsc -p tsconfig.widget.json --noEmit",
    "test": "node --experimental-transform-types --test test/*.test.ts",
    "test:runtime": "npm run build && node test/runtime.mjs",
    "test:widget": "npm run build:widget && node test/widget.mjs",
    "build:widget": "node scripts/build-preview-assets.mjs && node scripts/build-widget.mjs",
    "build": "npm run build:widget && wrangler deploy --dry-run --outdir dist",
    "dev": "npm run build:widget && wrangler dev",
    "deploy": "npm run check && npm test && npm run build:widget && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/sdk": "1.30.1",
    "marked": "18.0.14",
    "pg": "8.23.0",
    "sanitize-html": "2.17.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260928.1",
    "@playwright/test": "1.63.0",
    "@types/node": "25.2.2",
    "@types/pg": "8.23.1",
    "@types/sanitize-html": "2.16.2",
    "esbuild": "0.28.1",
    "typescript": "5.9.3",
    "wrangler": "4.134.0"
  }
}
