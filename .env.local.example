# BASE_URL="https://mycustomdomain.com" # In production, set this to the single canonical app URL.
# ADMIN_EMAILS="admin@example.com,other-admin@example.com"
BETTER_AUTH_SECRET="random-string-of-characters"
# EMAIL_PROVIDER="resend" # or "smtp"
EMAIL_FROM="Coze CMS <no-reply@coze.care>"
# Resend config
# RESEND_API_KEY="your-resend-api-key"
# RESEND_FROM_EMAIL="Coze CMS <no-reply@coze.care>" # backwards-compatible alias for EMAIL_FROM
# SMTP config
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="smtp-user"
# SMTP_PASSWORD="smtp-password"
DATABASE_URL="postgresql://cozecms:cozecms@localhost:5432/cozecms"
# Direct Node.js DB connection. On Cloudflare, use the CMS_DATABASE Hyperdrive
# binding instead (origin TLS verify-full, Supabase CA, query caching disabled).
# For Node.js Supabase connections, set CMS_DATABASE_CA_CERT to the public CA PEM.
# Pooler mode uses port 6543; db/runtime-config.ts normalizes accidental 5432 URLs.
SG_POSTGRES_URL="postgresql://...pooler.supabase.com:6543/postgres"
# Migrations only (drizzle.config.ts). Use a direct connection when available,
# or Supabase session pooler mode on port 5432 when IPv4 is required.
SG_DATABASE_URL_UNPOOLED="postgresql://...pooler.supabase.com:5432/postgres"
# Supabase Storage (itinerary media). Project: coze (ihitnwzljfldctswwrsv, ap-northeast-2).
# SUPABASE_SERVICE_ROLE_KEY is server-only — never expose it to the client.
SUPABASE_URL="https://ihitnwzljfldctswwrsv.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
# Cloudflare Workers Builds deploy hook for the production coze-client trigger.
# Store the actual URL as a Worker secret. Never use a preview hook here.
# COZE_CLIENT_CLOUDFLARE_DEPLOY_HOOK_URL="set-in-worker-secrets"
# CLOUDFLARE_API_TOKEN="set-in-worker-secrets-for-build-status"
# CRON_SECRET="random-secret-for-the-durable-publish-sweep"
# CMS_RUNTIME="cloudflare"
# CMS_READ_ONLY="true" # Smoke previews block HTTP writes AND all DB access.
# Authenticated staging must use a separate test database with this flag false.
# Base URL of the live coze_client site, used to build "Preview" links in the
# Site pages editor. Client-exposed (NEXT_PUBLIC_) since the editor builds
# the link in the browser. Point this at a staging URL to preview unpublished
# deploys instead of production.
NEXT_PUBLIC_COZE_CLIENT_SITE_URL="https://www.coze.care"

# ChatGPT plugin/MCP connection. Keep off until migration 0023 and testing.
COZE_HOMEPAGE_MCP_ENABLED="false"
# BASE_URL must be the canonical HTTPS CMS origin. The existing AUTH_SECRET
# (or BETTER_AUTH_SECRET) must be stable and at least 32 characters.
# Homepage Git access is server-only; never include credentials in a plugin.
# COZE_CLIENT_GITHUB_TOKEN="set-in-host-secret-settings"
# COZE_CLIENT_GITHUB_REPO="cozmo-coze-ai/coze_client"
# COZE_CLIENT_GITHUB_BRANCH="main"
# COZE_CLIENT_SITE_URL="https://www.coze.care"
# Set true only after verifying this branch triggers the Cloudflare Git build.
COZE_CLIENT_CLOUDFLARE_GIT_DEPLOY_ENABLED="false"
